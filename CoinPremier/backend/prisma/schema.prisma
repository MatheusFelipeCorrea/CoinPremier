generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

enum Role {
ALUNO
PROFESSOR
EMPRESA
ADMIN
}

enum StatusUsuario {
ATIVO
BLOQUEADO
}

enum TipoTransacao {
ENVIO
RECEBIMENTO
RESGATE
CREDITO_SEMESTRAL
}

enum StatusCupom {
GERADO
UTILIZADO
EXPIRADO
CANCELADO
}

enum TagReconhecimento {
PARTICIPACAO
CRIATIVIDADE
LIDERANCA
COLABORACAO
DEDICACAO
EXCELENCIA_ACADEMICA
OUTRO
}

model Usuario {
id         String        @id @default(cuid())
nome       String
email      String        @unique
senhaHash  String
role       Role
status     StatusUsuario @default(ATIVO)
createdAt  DateTime      @default(now())
updatedAt  DateTime      @updatedAt

aluno      Aluno?
professor  Professor?
empresa    Empresa?
transacoes Transacao[]
cupons     Cupom[]
notificacoes Notificacao[]

@@index([email, status])
@@index([role, createdAt])
  @@index([status, role])
}

model Instituicao {
id          String      @id @default(cuid())
nome        String      @unique
sigla       String?
createdAt   DateTime    @default(now())
updatedAt   DateTime    @updatedAt
alunos      Aluno[]
professores Professor[]

  @@index([nome])
}

model Aluno {
id            String   @id @default(cuid())
usuarioId     String   @unique
cpf           String   @unique
rg            String   @unique
endereco      String
curso         String
saldoMoedas   Int      @default(0)
instituicaoId String
createdAt     DateTime @default(now())
updatedAt     DateTime @updatedAt

usuario          Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
instituicao      Instituicao @relation(fields: [instituicaoId], references: [id])
reconhecimentosRecebidos Reconhecimento[]
favoritos        Favorito[]
carrinhoItens    CarrinhoItem[]

@@index([instituicaoId])
@@index([createdAt])
}

model Professor {
id                    String   @id @default(cuid())
usuarioId             String   @unique
cpf                   String   @unique
departamento          String
saldoMoedas           Int      @default(0)
ultimoSemestreCredito String?  // formato "2026-1" ou "2026-2"
instituicaoId         String
createdAt             DateTime @default(now())
updatedAt             DateTime @updatedAt

usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
instituicao     Instituicao      @relation(fields: [instituicaoId], references: [id])
reconhecimentosFeitos Reconhecimento[]

@@index([instituicaoId])
  @@index([instituicaoId, departamento])
}

model Empresa {
id         String   @id @default(cuid())
usuarioId  String   @unique
cnpj       String   @unique
descricao  String
createdAt  DateTime @default(now())
updatedAt  DateTime @updatedAt

usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
vantagens  Vantagem[]

@@index([createdAt])
}

model Categoria {
id        String     @id @default(cuid())
nome      String     @unique
slug      String     @unique
icone     String?
vantagens Vantagem[]

  @@index([slug])
}

model Vantagem {
id                 String   @id @default(cuid())
titulo             String
descricao          String
custoMoedas        Int
foto               String?
estoque            Int?     // null = ilimitado
ativo              Boolean  @default(true)
validadeCupomDias  Int      @default(30)
limitePorAluno     Int?     // null = sem limite
empresaId          String
categoriaId        String?
createdAt          DateTime @default(now())
updatedAt          DateTime @updatedAt

empresa    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
categoria  Categoria?     @relation(fields: [categoriaId], references: [id])
cupons     Cupom[]
favoritos  Favorito[]
carrinhoItens CarrinhoItem[]

@@index([empresaId])
@@index([empresaId, ativo, createdAt])
@@index([categoriaId, ativo])
@@index([ativo, categoriaId, createdAt])
}

model Favorito {
id         String   @id @default(cuid())
alunoId    String
vantagemId String
createdAt  DateTime @default(now())

aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
vantagem  Vantagem @relation(fields: [vantagemId], references: [id], onDelete: Cascade)

@@unique([alunoId, vantagemId])
@@index([alunoId, createdAt])
}

model CarrinhoItem {
id         String   @id @default(cuid())
alunoId    String
vantagemId String
quantidade Int      @default(1)
createdAt  DateTime @default(now())

aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
vantagem  Vantagem @relation(fields: [vantagemId], references: [id], onDelete: Cascade)

@@unique([alunoId, vantagemId])
@@index([alunoId, createdAt])
}

model Reconhecimento {
id           String            @id @default(cuid())
professorId  String
alunoId      String
quantidade   Int
mensagem     String
tag          TagReconhecimento @default(OUTRO)
createdAt    DateTime          @default(now())

professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
aluno     Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

@@index([alunoId, createdAt])
@@index([alunoId, createdAt(sort: Desc)], map: "Reconhecimento_alunoId_createdAt_desc_idx")
@@index([professorId, createdAt])
  @@index([professorId, createdAt(sort: Desc)], map: "Reconhecimento_professorId_createdAt_desc_idx")
  @@index([professorId, tag, createdAt])
  @@index([professorId, alunoId, createdAt])
}

model Transacao {
id               String        @id @default(cuid())
tipo             TipoTransacao
descricao        String
quantidadeMoedas Int
usuarioId        String
referenciaId     String?       // id do reconhecimento/cupom relacionado
createdAt        DateTime      @default(now())

usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

@@index([usuarioId, createdAt])
@@index([usuarioId, tipo, createdAt(sort: Desc)])
@@index([tipo, createdAt])
@@index([createdAt, tipo])
}

model Cupom {
id                String      @id @default(cuid())
codigo            String      @unique
usuarioId         String
vantagemId        String
custoMoedasSnapshot Int       // preço travado na hora
status            StatusCupom @default(GERADO)
dataValidade      DateTime
dataUtilizacao    DateTime?
validadoPorEmpresaId String?  // auditoria: quem validou
createdAt         DateTime    @default(now())
updatedAt         DateTime    @updatedAt

usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
vantagem Vantagem @relation(fields: [vantagemId], references: [id], onDelete: Cascade)

@@index([status, dataValidade])
@@index([status, createdAt])
@@index([usuarioId, status])
@@index([usuarioId, status, dataValidade])
  @@index([usuarioId, createdAt])
  @@index([vantagemId, createdAt])
  @@index([vantagemId, status])
@@index([vantagemId, status, createdAt])
@@index([validadoPorEmpresaId, dataUtilizacao])
}

model Notificacao {
id         String   @id @default(cuid())
usuarioId  String
titulo     String
mensagem   String
tipo       String?
lida       Boolean  @default(false)
link       String?
deletedAt  DateTime?
createdAt  DateTime @default(now())

usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

@@index([usuarioId, lida, createdAt])
@@index([usuarioId, createdAt])
@@index([usuarioId, tipo, createdAt])
@@index([usuarioId, deletedAt, createdAt])
}